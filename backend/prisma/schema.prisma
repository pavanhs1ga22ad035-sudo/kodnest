generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  ADMIN
}

enum SessionStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum PlacementApplicationStatus {
  APPLIED
  SHORTLISTED
  INTERVIEWING
  OFFERED
  REJECTED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String                 @id @default(cuid())
  fullName         String
  email            String                 @unique
  passwordHash     String
  phone            String?
  avatarUrl        String?
  role             UserRole               @default(STUDENT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  courseEnrollments CourseEnrollment[]
  topicProgress    TopicProgress[]
  mentoredSessions LiveSession[]          @relation("SessionMentor")
  placementApplications PlacementApplication[]
  leaveRequests    LeaveRequest[]
}

model Course {
  id               String                 @id @default(cuid())
  title            String
  slug             String                 @unique
  description      String?
  thumbnailUrl     String?
  isPublished      Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  modules          Module[]
  liveSessions     LiveSession[]
  enrollments      CourseEnrollment[]
  placements       JobPlacement[]
}

model Module {
  id               String                 @id @default(cuid())
  courseId         String
  title            String
  description      String?
  orderIndex       Int

  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topics           Topic[]

  @@unique([courseId, orderIndex])
}

model Topic {
  id               String                 @id @default(cuid())
  moduleId         String
  title            String
  description      String?
  videoUrl         String?
  durationMins     Int?
  orderIndex       Int

  module           Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressRecords  TopicProgress[]

  @@unique([moduleId, orderIndex])
}

model CourseEnrollment {
  id               String                 @id @default(cuid())
  userId           String
  courseId         String
  status           EnrollmentStatus       @default(ACTIVE)
  progressPercent  Decimal                @default(0) @db.Decimal(5, 2)
  enrolledAt       DateTime               @default(now())
  completedAt      DateTime?

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model TopicProgress {
  id               String                 @id @default(cuid())
  userId           String
  topicId          String
  watchedSeconds   Int                    @default(0)
  completed        Boolean                @default(false)
  completedAt      DateTime?
  lastAccessedAt   DateTime               @default(now())

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            Topic                  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
}

model LiveSession {
  id               String                 @id @default(cuid())
  courseId         String
  mentorId         String?
  title            String
  description      String?
  meetingUrl       String?
  startsAt         DateTime
  endsAt           DateTime
  status           SessionStatus          @default(UPCOMING)
  createdAt        DateTime               @default(now())

  course           Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mentor           User?                  @relation("SessionMentor", fields: [mentorId], references: [id])
}

model JobPlacement {
  id               String                 @id @default(cuid())
  courseId         String?
  companyName      String
  roleTitle        String
  location         String?
  packageLpa       Decimal?               @db.Decimal(10, 2)
  details          String?
  applyUrl         String?
  postedAt         DateTime               @default(now())
  deadlineAt       DateTime?

  course           Course?                @relation(fields: [courseId], references: [id])
  applications     PlacementApplication[]
}

model PlacementApplication {
  id               String                 @id @default(cuid())
  userId           String
  placementId      String
  status           PlacementApplicationStatus @default(APPLIED)
  appliedAt        DateTime               @default(now())
  notes            String?

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  placement        JobPlacement           @relation(fields: [placementId], references: [id], onDelete: Cascade)

  @@unique([userId, placementId])
}

model LeaveRequest {
  id               String                 @id @default(cuid())
  userId           String
  reason           String
  startDate        DateTime
  endDate          DateTime
  status           LeaveStatus            @default(PENDING)
  adminRemark      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
